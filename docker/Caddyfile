:80 {
	@root path /
	redir @root /app 302
	redir /app /app/ 308
	redir /srv /srv/ 308
	redir /srv/admin /srv/admin/ 308
	redir /admin /admin/ 308

	@modelFiles path_regexp modelFiles \.(onnx|onnx_data)$
	header @modelFiles Cache-Control "public, max-age=604800"
	@compressible {
		not path_regexp \.(onnx|onnx_data)$
	}
	encode @compressible zstd gzip

	handle_path /app/* {
		root * /workspace/app/static
		try_files {path} {path}/ /index.html
		file_server {
			precompressed br zstd gzip
		}
	}

	handle_path /srv/static/* {
		root * /srv/staticfiles
		file_server {
			precompressed br zstd gzip
		}
	}

	handle /srv/* {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}
}
