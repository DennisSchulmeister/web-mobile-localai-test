:80 {
	@root path /
	redir @root /app 302
	redir /app /app/ 308
	redir /srv /srv/ 308
	redir /srv/admin /srv/admin/ 308
	redir /admin /admin/ 308

	handle_path /app/* {
		root * /workspace/app/static
		try_files {path} {path}/ /index.html
		file_server
	}

	handle_path /srv/static/* {
		root * /srv/staticfiles
		file_server
	}

	handle /srv/* {
		reverse_proxy backend-postgres:8000
	}

	handle /admin/* {
		reverse_proxy backend-postgres:8000
	}
}
