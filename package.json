{
    "name": "@dschulmeis/web-mobile-localai-test",
    "version": "1.0.0",
    "description": "Web/Mobile-Test für lokale KI",
    "author": "Dennis Schulmeister-Zimolong",
    "private": "true",
    "type": "module",
    "scripts": {
        "clean": "node bin/clean.js",
        "build": "npm run clean && node bin/esbuild/bundle.js",
        "start": "node bin/esbuild/serve.js",
        "watch": "node bin/esbuild/serve.js",
        "init": "npm run prepare:download && npm run prepare:preprocess && npm run prepare:embeddings",
        "init:download": "node bin/init/download.js static/models/index.json static/_generated/models",
        "init:preprocess": "node bin/init/preprocess.js static/data/index.json static/_generated/preprocessed",
        "init:embeddings": "node bin/init/embeddings.js static/data/index.json static/_generated/embeddings"
    },
    "config": {
        "clean_dirs": "static/_bundle:static/_generated"
    },
    "devDependencies": {
        "@huggingface/transformers": "^4.2.0",
        "@picocss/pico": "^2.1.1",
        "bootstrap-icons": "^1.13.1",
        "chalk": "^6.0.0",
        "esbuild": "^0.28.2",
        "markdown-it": "^15.0.0",
        "nodejs-file-downloader": "^4.13.0",
        "shelljs": "^0.10.0",
        "svelte": "^5.56.10",
        "svelte-check": "^4.7.6",
        "svelte-preprocess": "^6.0.5",
        "svelte-spa-router": "^5.1.1"
    },
    "dependencies": {
        "esbuild-svelte": "^0.9.5"
    }
}
