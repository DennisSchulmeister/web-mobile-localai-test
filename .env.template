#======================================================================
# Environment variables for the Docker Compose setup.
# Create a copy called .env and adapt the values as needed.
#======================================================================

# Database driver: postgres or mysql
DATABASE_DRIVER=postgres
DATABASE_NAME=wmlt
DATABASE_USER=wmlt
DATABASE_PASSWORD=wmlt

# Use "db" when running the Database with Docker.
# Use "host.docker.internal" for a local database server on the host machine.
# Use any other hostname for an external database server.
DATABASE_HOST=host.docker.internal

# Leave empty to use the driver's default port (5432 for PostgreSQL, 3306 for MySQL).
DATABASE_PORT=

# Django static files
DJANGO_STATIC_ROOT=/srv/static
DJANGO_STATIC_URL=/srv/static/

# Set to /srv for the full Caddy profile; leave empty otherwise.
# Also set, when serving the Django backend as a sub-directory, e.g. "/django".
DJANGO_SCRIPT_NAME=

DJANGO_PORT=8000
HTTP_PORT=8080
